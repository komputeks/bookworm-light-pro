{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@lib": [
        "./src/lib/index"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@config": [
        "./src/config/index"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@schemas": [
        "./src/schemas/index"
      ],
      "@schemas/*": [
        "./src/schemas/*"
      ],
      "@services": [
        "./src/services/index"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@types": [
        "./src/types/index"
      ],
      "@types/*": [
        "./src/types/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@actions/*": [
        "./src/actions/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@providers": [
        "./src/providers/index"
      ],
      "@providers/*": [
        "./src/providers/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
